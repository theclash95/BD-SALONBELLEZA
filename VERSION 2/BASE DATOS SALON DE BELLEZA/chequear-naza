    // --- CATEGORÍA PRODUCTOS ---
    public async Task ActualizarCategoriaProductoAsync(int idCategoria, string nombre, string? descripcion)
    {
        using var c = (MySqlConnection)await _conn.ObtenerConexionAsync();
        using var cmd = new MySqlCommand("ActualizarCategoriaProducto", c) { CommandType = CommandType.StoredProcedure };
        cmd.Parameters.AddWithValue("@p_id_categoria", idCategoria);
        cmd.Parameters.AddWithValue("@p_nombre", nombre);
        cmd.Parameters.AddWithValue("@p_descripcion", descripcion ?? (object)DBNull.Value);
        await cmd.ExecuteNonQueryAsync();
    }

    public async Task DesactivarCategoriaProductoAsync(int idCategoria)
